// Field names are deliberately snake_case and identical to the column names: the API returns
// rows straight to the frontend, so camelCasing here would rename every JSON key.
//
// CHECK constraints (org type, campaign/partnership status, guest_rate <= coin_rate, ...) are
// not expressible in the Prisma schema. They live in the migration SQL instead. Prisma's
// differ ignores them, so they persist across `migrate dev` rather than being dropped as drift.
//
// The same is true of the two PARTIAL unique indexes on `redemptions` — see the note on that
// model. Those are not ignored by the differ, so this schema is applied with `migrate deploy`
// against the migration SQL, never regenerated from the models.

generator client {
  provider = "prisma-client"
  // Inside src/ so `tsc` compiles it with everything else — Prisma 7 emits TypeScript, not JS.
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// A tenant. Login is the org (single-user); split out a users table when teams matter.
model Org {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String
  /// promoter | publisher | admin — enforced by CHECK
  type          String
  email         String   @unique
  password_hash String
  /// publishers only; sha256 of the partner API key
  api_key_hash  String?
  /// publishers only; web fallback for desktop scans and publishers with no app yet
  landing_url   String?
  /// publishers only; an https URL registered as an Android App Link / iOS Universal Link.
  /// Engagement scans are sent here so the OS opens the app when it is installed and falls
  /// back to the store when it is not — a question no server can answer and both platforms can.
  deeplink_url  String?
  /// publishers only; Play listing a scan sends Android phones to (com.example.app)
  android_package String?
  /// publishers only; numeric App Store id a scan sends iPhones to
  ios_app_id      String?
  /// publishers only; describes the publisher's OWN joining bonus. A label for reporting
  /// and QR artwork — never an instruction this platform issues or fulfils.
  bonus_label     String?
  suspended     Boolean  @default(false)
  created_at    DateTime @default(now()) @db.Timestamptz(6)

  promoter_partnerships  Partnership[] @relation("promoter")
  publisher_partnerships Partnership[] @relation("publisher")
  audit_entries          AuditLog[]

  @@index([api_key_hash])
  @@map("orgs")
}

model Partnership {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  promoter_org_id   String   @db.Uuid
  publisher_org_id  String   @db.Uuid
  /// coins paid for an identified redemption
  coin_rate         Int      @default(50)
  /// coins paid up front for an unidentified one; the delta is held back until upgrade
  guest_rate        Int      @default(10)
  /// how long after a guest redemption the delta can still be claimed
  grace_days        Int      @default(7)
  /// coins paid for one repeat purchase in an `engagement` campaign. Its own number because it
  /// is its own product: `coin_rate` prices somebody who was not a user before, this prices a
  /// customer who came back. Deliberately unrelated to the two above — no pair rule.
  engagement_rate   Int      @default(20)
  /// A repricing the promoter has asked for and the publisher has not agreed to yet. NULL = no
  /// open proposal. Nothing pays out at these numbers: the columns above stay in force until
  /// the publisher accepts, which copies these over them and clears them. Set and cleared as a
  /// pair, so the `guest_rate <= coin_rate` rule can be checked on the pair the way it is above.
  proposed_coin_rate       Int?
  proposed_guest_rate      Int?
  proposed_engagement_rate Int?
  /// pending | active | suspended — enforced by CHECK. `pending` is only ever "waiting on the
  /// publisher"; an admin pausing the relationship uses `suspended`, which `accept` cannot lift.
  status            String   @default("pending")
  created_at        DateTime @default(now()) @db.Timestamptz(6)

  promoter  Org        @relation("promoter", fields: [promoter_org_id], references: [id])
  publisher Org        @relation("publisher", fields: [publisher_org_id], references: [id])
  campaigns Campaign[]

  @@unique([promoter_org_id, publisher_org_id])
  @@index([promoter_org_id])
  @@index([publisher_org_id])
  @@map("partnerships")
}

model Campaign {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  partnership_id String   @db.Uuid
  name           String
  /// active | paused | ended — enforced by CHECK
  status         String   @default("active")
  /// acquisition | engagement — enforced by CHECK. Selects which payout guarantee applies:
  /// one per user per campaign (acquisition), or one per issued code (engagement, so a
  /// traveller who flies eleven times is paid for eleven flights).
  mode           String   @default("acquisition")
  created_at     DateTime @default(now()) @db.Timestamptz(6)

  partnership Partnership  @relation(fields: [partnership_id], references: [id])
  qr_codes    QrCode[]
  scans       Scan[]
  redemptions Redemption[]

  @@index([partnership_id])
  @@map("campaigns")
}

model QrCode {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  campaign_id String    @db.Uuid
  code        String    @unique
  /// colors, size, margin, ecc, logo (data URL)
  style       Json      @default("{}")
  /// NULL = never expires (admin override only)
  expires_at  DateTime? @db.Timestamptz(6)
  /// NULL = unlimited uses (admin override only)
  max_uses    Int?
  uses        Int       @default(0)
  voided      Boolean   @default(false)
  /// The promoter's own reference for the transaction this code was minted against — a PNR, an
  /// order number, a receipt line. Nothing reads it; it exists so minting is idempotent, and a
  /// booking webhook that fires twice collides here instead of issuing two rewards. NULL for
  /// every code designed in the portal, and NULLs are distinct in a unique index.
  issued_ref  String?
  created_at  DateTime  @default(now()) @db.Timestamptz(6)

  campaign    Campaign     @relation(fields: [campaign_id], references: [id])
  scans       Scan[]
  redemptions Redemption[]

  @@unique([campaign_id, issued_ref])
  @@index([campaign_id])
  @@map("qr_codes")
}

/// A scan is an attribution claim waiting to be matched. Nothing here is redeemable by the
/// device: `claim_id` travels only through Play's install-referrer channel, and the iOS path
/// carries nothing at all.
model Scan {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  qr_code_id  String   @db.Uuid
  campaign_id String   @db.Uuid
  /// opaque id placed in the Play install referrer; the deterministic match key
  claim_id    String   @unique
  /// android | ios | other — one half of the fingerprint used when no referrer exists
  platform    String   @default("other")
  /// truncated sha256 of the client IP, never the IP itself — the other fingerprint half
  ip          String?
  user_agent  String?
  /// true once this scan has been matched to an install
  consumed    Boolean  @default(false)
  scanned_at  DateTime @default(now()) @db.Timestamptz(6)

  /// Reporting dimensions, all read off the request headers at redirect time and all optional
  /// — nothing here feeds attribution, so a missing value costs a report bucket, never a match.
  /// ISO-3166 alpha-2 resolved by the CDN in front of us; NULL off a CDN.
  country      String?
  city         String?
  /// primary Accept-Language tag, e.g. `en-us`
  language     String?
  /// host that linked here — empty for a camera scan, set when the URL was clicked on a page
  referer_host String?
  os           String?
  /// includes in-app webviews (Instagram, TikTok, …), which is the channel signal
  browser      String?
  /// mobile | tablet | desktop — enforced by CHECK
  device_type  String?

  /// Fingerprint signals collected by the interstitial, NULL when it was skipped (Android,
  /// desktop) or when JS never ran. Unlike the reporting columns above these DO feed matching,
  /// so both sides — browser at scan, SDK at first open — must spell them the same way.
  /// IANA zone, e.g. `Asia/Dhaka`.
  tz           String?
  /// `{short}x{long}@{dpr}` in CSS px / points, orientation-normalised: `393x852@3`.
  screen       String?
  /// logical CPU count — `hardwareConcurrency` here, `activeProcessorCount` in the SDK
  cores        Int?     @db.SmallInt
  /// dark appearance at scan time — `prefers-color-scheme` here, `userInterfaceStyle` in the SDK
  dark         Boolean?

  /// Everything else the hand-off screen measured. Reporting only, deliberately schemaless: none
  /// of it survives the browser → native crossing well enough to be evidence, and it is read as
  /// a per-scan detail rather than grouped, so a column each would be seven migrations for a
  /// tooltip. Keys are fixed by `clientSignals()`; NULL when the screen was skipped.
  client       Json?

  qr_code    QrCode      @relation(fields: [qr_code_id], references: [id])
  campaign   Campaign    @relation(fields: [campaign_id], references: [id])
  /// At most two, and never two of a kind: one acquisition (the scanner was a new user) and
  /// one engagement (the scanner had just bought something). A boarding pass scanned by
  /// somebody with no app yet is honestly both. Enforced by two partial unique indexes — see
  /// the note on `Redemption`.
  redemptions Redemption[]
  install    Install?

  @@index([campaign_id])
  @@index([scanned_at(sort: Desc)])
  /// the fingerprint lookup: unmatched scans for one device shape, newest first
  @@index([ip, platform, consumed, scanned_at(sort: Desc)])
  /// every analytics breakdown: one campaign over a recent window
  @@index([campaign_id, scanned_at(sort: Desc)])
  @@map("scans")
}

/// The middle stage: the app opened for the first time and we tied that open back to a scan.
///
/// This is where matching now happens, and the reason it is its own table. First open is
/// minutes after the scan; signup can be days later. Matching at signup meant the iOS
/// fingerprint window had to cover install + onboarding + registration, which no honest
/// window can — so it either missed every real install or was wide enough to match strangers.
/// Binding here keeps the window tight, and the signup below can then take as long as it likes.
///
/// Nothing is paid at this stage. An install with no signup earns nobody anything.
model Install {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  scan_id          String   @unique @db.Uuid
  campaign_id      String   @db.Uuid
  /// denormalised from the partnership: every fraud query filters by it, and the join to
  /// get there is three tables deep
  publisher_org_id String   @db.Uuid
  /// referrer | fingerprint
  match_method     String
  /// 0–100. 100 = Play handed us the exact claim id; below that, how many fingerprint
  /// signals agreed. Stored rather than recomputed so a review months later sees what the
  /// decision was actually made on.
  confidence       Int
  /// hash of the signals that identify one handset, for the repeat-device check. Only ever
  /// set on the probabilistic path — a deterministic claim id is already unique per scan.
  device_hash      String?
  /// SDK-asserted device integrity (emulator/rooted/vpn) plus whatever else was rejected on.
  /// Recorded on accepted installs too: the interesting fraud pattern is the one that passed.
  risk             Json     @default("{}")
  /// true once a signup consumed it — the race-proof one-signup-per-install guard
  redeemed         Boolean  @default(false)
  first_open_at    DateTime @default(now()) @db.Timestamptz(6)
  /// after this the install can no longer be turned into a signup
  expires_at       DateTime @db.Timestamptz(6)

  scan       Scan        @relation(fields: [scan_id], references: [id])
  redemption Redemption?

  /// the repeat-device check: one campaign, one handset, a recent window
  @@index([campaign_id, device_hash, first_open_at(sort: Desc)])
  @@index([publisher_org_id])
  @@map("installs")
}

model Redemption {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  campaign_id         String    @db.Uuid
  /// Not `@unique` up here even though it is unique in the database: that index is partial too
  /// (acquisitions only), so one scan can carry both a signup and a purchase reward.
  scan_id             String    @db.Uuid
  /// NULL only for signups that arrived on the legacy single-call path
  install_id          String?   @unique @db.Uuid
  /// The issued code this repeat-purchase reward was paid against. Set on `engagement` rows and
  /// NULL on `acquisition` ones — a CHECK ties the two together, so `kind` can never disagree
  /// with which of the two partial unique indexes a row is actually living under.
  qr_code_id          String?   @db.Uuid
  publisher_user_ref  String
  coins               Int
  identified          Boolean   @default(true)
  /// acquisition | engagement — copied off the campaign because the money invariant for each
  /// is a partial unique index, and an index cannot reach through a join to read the mode.
  kind                String    @default("acquisition")
  /// referrer | fingerprint | code — how the payout was tied back to a scan. Deterministic
  /// matches are auditable; probabilistic ones are the ones to sample for fraud. `code` is the
  /// engagement path: the code was minted against one transaction and scanned once.
  match_method        String    @default("referrer")
  /// copied off the install rather than joined: every fraud-review list renders it per row
  confidence          Int       @default(100)
  upgraded_at         DateTime? @db.Timestamptz(6)
  created_at          DateTime  @default(now()) @db.Timestamptz(6)

  campaign Campaign @relation(fields: [campaign_id], references: [id])
  scan     Scan     @relation(fields: [scan_id], references: [id])
  install  Install? @relation(fields: [install_id], references: [id])
  qr_code  QrCode?  @relation(fields: [qr_code_id], references: [id])

  /// The payout guarantees are PARTIAL unique indexes and live in the migration SQL, for the
  /// same reason the CHECK constraints do — Prisma cannot express a `WHERE` on an index:
  ///
  ///   UNIQUE (campaign_id, publisher_user_ref) WHERE kind = 'acquisition'
  ///   UNIQUE (scan_id)                         WHERE kind = 'acquisition'
  ///   UNIQUE (qr_code_id)                      WHERE kind = 'engagement'
  ///
  /// Declaring either up here would create a *total* unique index instead, and the first one
  /// would re-impose "one payout per user, ever" on the engagement rows this whole feature
  /// exists to allow. Look them up with `findFirst`, never `findUnique`.
  @@index([created_at(sort: Desc)])
  @@map("redemptions")
}

/// Append-only double-entry ledger: positive = credit, negative = debit; entries per ref sum to zero.
///
/// "Append-only" is a trigger in the migration SQL, not a convention up here — UPDATE, DELETE
/// and TRUNCATE all raise. Corrections are posted as compensating entries.
model LedgerEntry {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// campaign:{id} | publisher:{org_id} | external:funding
  account    String
  amount     Int
  ref        String
  created_at DateTime @default(now()) @db.Timestamptz(6)

  /// The replay guard: a retried credit carrying the same ref collides instead of doubling the
  /// money. Its `account` prefix also serves every by-account lookup, so there is no second index.
  @@unique([account, ref])
  @@index([ref])
  @@map("ledger_entries")
}

/// Materialised sum of ledger_entries per account. Locked FOR UPDATE on every money path.
model AccountBalance {
  account String @id
  balance Int    @default(0)

  @@map("account_balances")
}

/// Every privileged override lands here, so rule changes are explainable after the fact.
model AuditLog {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actor_org_id  String?  @db.Uuid
  action        String
  target        String
  detail        Json     @default("{}")
  created_at    DateTime @default(now()) @db.Timestamptz(6)
  /// Admin's read mark, and the only mutable field here. An entry written by a *tenant* is
  /// something the platform did not do itself, so it sits in the admin's notifications until
  /// this is set. Admin's own entries never show up there and never need it.
  acknowledged_at DateTime? @db.Timestamptz(6)

  actor Org? @relation(fields: [actor_org_id], references: [id])

  @@index([created_at(sort: Desc)])
  @@map("audit_log")
}
