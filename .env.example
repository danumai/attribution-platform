# Copy to .env for local development: `cp .env.example .env`
# Both workspaces load it via `node --env-file-if-exists=../.env` (see package.json scripts).
#
# In production do NOT ship this file — inject these as real environment variables.
# The backend refuses to boot if the starred (*) ones are missing or still at defaults.

# ---------- required in production ----------
DATABASE_URL=postgres://qrreward:qrreward@localhost:5436/qrreward
# Managed Postgres: append ?sslmode=require (pg reads it straight from the URL).
# Used by the app and by the Prisma CLI (backend/prisma.config.ts loads this file).

# * Public origin of the API. Encoded into every QR as ${BASE_URL}/r/{code}.
#   Getting this wrong after codes are printed means a reprint — there is no fix in software.
BASE_URL=http://localhost:4000

# * Browser origin(s) allowed by CORS, comma-separated. The first is canonical and is
#   used for scan redirects. Must be https in production.
FRONTEND_URL=http://localhost:3000

# * Signs sessions and scan tokens. Generate with: openssl rand -hex 32
#   Booting production with the value below is refused outright — it is a full auth bypass.
JWT_SECRET=dev-secret-change-me

# * Super admin, seeded on first boot only. Never created through signup.
#   In production the password must be 12+ chars and is NOT reset on redeploy.
ADMIN_EMAIL=admin@qrreward.local
ADMIN_PASSWORD=admin12345

# ---------- optional ----------
# PORT=4000
# DB_POOL_MAX=10
# `prisma migrate dev` replays migrations into a throwaway database to detect drift, and
# creates one itself by default. Managed Postgres usually forbids CREATE DATABASE — point
# this at a second empty database there instead. Never at the real one; it gets reset.
# SHADOW_DATABASE_URL=postgres://user:pw@host/qrreward_shadow
# NODE_ENV=production
# Behind a load balancer, req.ip must be the real client or per-IP rate limits collapse
# into one bucket. See https://expressjs.com/en/guide/behind-proxies.html
# Use the hop count or the proxy subnet. `true` is refused at boot: it trusts
# X-Forwarded-For from ANY client, so one attacker becomes unlimited distinct IPs and
# every per-IP control (login throttle, scan limit, iOS fingerprint) stops working.
# TRUST_PROXY=1

# ---------- development only ----------
# These demo tenants are re-seeded on every boot and are SKIPPED entirely when
# NODE_ENV=production. Sign in with them at http://localhost:3000/login
PROMOTER_NAME=Air Dhaka
PROMOTER_EMAIL=promoter@demo.com
PROMOTER_PASSWORD=password123

PUBLISHER_NAME=DramaBox
PUBLISHER_EMAIL=publisher@demo.com
PUBLISHER_PASSWORD=password123
PUBLISHER_LANDING_URL=http://localhost:3000/publisher-sim
PUBLISHER_API_KEY=pk_devdevdevdevdevdevdevdevdevdevdevdevdevdevdevdev

# Baked into the frontend bundle at BUILD time, not read at runtime.
NEXT_PUBLIC_API_URL=http://localhost:4000
# Prefilled into the login form
NEXT_PUBLIC_DEMO_EMAIL=promoter@demo.com
NEXT_PUBLIC_DEMO_PASSWORD=password123
