node_modules/
.next/
dist/
*.tsbuildinfo
# Every .env variant, not just `.env` — a `.env.backup` / `.env.prod` / `.env.local`
# holds the same live credentials and is exactly what gets committed by accident.
.env*
!.env.example
.DS_Store

# Prisma client is generated from prisma/schema.prisma at install/build time
backend/prisma/generated/

# Per-developer editor and assistant config. These name absolute paths on one machine and
# rewrite themselves on every edit, so tracking them is a merge conflict per commit.
.vscode/
.cursor/
.claude/
.superpowers/
.agents/
# Contents, not the directory itself — git cannot re-include a file whose parent directory
# is excluded, and the design system below has to survive the rule above it.
**/.impeccable/*
*.local.json
# The design system describes the project rather than the developer, so it stays tracked.
!.impeccable/design.json
# Regenerated from .agents/, which is ignored above.
skills-lock.json
